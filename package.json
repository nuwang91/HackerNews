{
  "name": "nas-hacker",
  "version": "0.0.0",
  "scripts": {
    "commit": "cz",
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "test": "ng test",
    "lint": "ng lint",
    "e2e": "ng e2e",
